# ─────────────────────────────────────────────────────────────
# Coolify environment variables — kikovargas.fit
# Paste these in: Coolify → Project → App → Environment Variables
# Set "Is Build Variable" ONLY for NEXT_PUBLIC_* vars.
# ─────────────────────────────────────────────────────────────

# ─── Required ────────────────────────────────────────────────

# Database (Coolify auto-injects this if you link a Postgres resource:
# postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:5432/${POSTGRES_DB})
DATABASE_URL=postgresql://USER:PASSWORD@kikovargas-db:5432/kikovargas

# Auth/crypto secrets (generate with: openssl rand -base64 64 / -hex 32)
JWT_SECRET=
ENCRYPTION_KEY=

# Public base URL (no trailing slash) — also set as BUILD variable for SEO/metadata
NEXT_PUBLIC_URL=https://kikovargas.fit

# Timezone (server-side date calculations)
TZ=Europe/Madrid

# Node env
NODE_ENV=production

# ─── Emails (Resend) ────────────────────────────────────────
RESEND_API_KEY=re_
EMAIL_FROM=Kiko Vargas <hola@kikovargas.fit>

# ─── Optional ───────────────────────────────────────────────

# OpenAI (leave blank — Kiko configures from /dashboard/ajustes)
# OPENAI_API_KEY=

# Ollama fallback (only if you run Ollama on the same host)
# OLLAMA_BASE_URL=http://ollama:11434
# OLLAMA_MODEL=llama3.2

# Custom Next.js telemetry
NEXT_TELEMETRY_DISABLED=1
